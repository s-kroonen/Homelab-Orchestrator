# check.config — the standard's settings for scripts/check, scripts/setup and CI (Homelab Orchestrator). Sourced by bash.
# A STANDARD FILE: every `copier update` (scripts/update-standard) replaces it. Never edit it; the
# project's own values go into project.config, which is sourced after this file and wins.
# A guardrail file (.guardrails): agents don't change it; humans change it through a reviewed PR.

# --- Stack profile (copier question "stack"; change with `copier update --data stack=<name>`) -------
# Empty = not configured (skip locally, FAIL in CI). "none" = not applicable.
# Every stack must define TEST_LIST_CMD (zero tests = failure), SKIP_MARKERS and ASSERT_PATTERN
# (test integrity) and COVERAGE_CMD; tests/quality-canary/ proves the gates fail on planted cases.
# A project overrides a command in project.config.
# Python with uv (lockfile uv.lock); ruff, mypy, pytest (+pytest-cov) as dev dependencies.
# The canary folders hold planted problems: the gates skip them (inside a case the paths don't match).
INSTALL_CMD="uv sync --frozen"
RUFF_EXCLUDE="--config 'extend-exclude=[\"tests/quality-canary\", \"tests/security-canary\", \"spikes\", \".specify\"]'"
FORMAT_CMD="uv run ruff format --check $RUFF_EXCLUDE ."
FORMAT_FILE_CMD="uv run ruff format {file}"   # after each edit by the agent (.claude/hooks/format-file.sh)
LINT_FILE_CMD="uv run ruff check {file}"   # after each edit by the agent (.claude/hooks/lint-file.sh)
LINT_CMD="uv run ruff check $RUFF_EXCLUDE ."
TYPECHECK_CMD="uv run mypy --exclude '^(tests/(quality|security)-canary|spikes|\.specify)/' ."
PYTEST_IGNORE="--ignore=tests/quality-canary --ignore=tests/security-canary --ignore=spikes"
TEST_CMD="uv run pytest -q $PYTEST_IGNORE"
TEST_LIST_CMD="uv run pytest --collect-only -q $PYTEST_IGNORE 2>/dev/null | grep '::'"
SKIP_MARKERS='@pytest\.mark\.(skip|skipif|xfail)|pytest\.skip\(|unittest\.skip'
ASSERT_PATTERN='(^|[^a-z_])assert[ (]|pytest\.raises|self\.assert'
BUILD_CMD="uv build --quiet"
COVERAGE_CMD="uv run pytest -q $PYTEST_IGNORE --cov --cov-report=xml:coverage.xml"
COVERAGE_FILE="coverage.xml"
SAFETY_TEST_CMD="uv run pytest -q $PYTEST_IGNORE -m safety"
SAFETY_TEST_LIST_CMD="uv run pytest --collect-only -q $PYTEST_IGNORE -m safety 2>/dev/null | grep '::'"
OPENGREP_OPEN_RULESETS="python dockerfile generic/secrets yaml/github-actions"
OPENGREP_RULES=".opengrep/rules/custom .opengrep/rules/project .opengrep/rules/open"   # project/ is the project's own rules
OPENGREP_EXCLUDE_RULES=""
SAFETY_REQUIRED=false   # constitution VII: safety-tagged tests must exist and pass
QUALITY_CANARY_DIR="tests/quality-canary/python"

# --- Rules -----------------------------------------------------------------------------------------
ISSUE_KEY="OR"
AGENT_BRANCH_RE='^(feat|fix|release|claude)/|^ccr-'   # agent branches (same as .claude/hooks/git-policy.sh)
COMMIT_TYPES="feat|fix|docs|refactor|perf|test|build|ci|chore|revert"
COMMIT_KEY_REQUIRED="feat|fix"                # these types must carry the issue key as scope
PR_MAX_LINES=800                              # agentic PRs (bugs, releases) are checked against this
FIX_MAX_LINES=200                             # fix/ branches: more is not a small fix (escalate to a person)
# A fix/ branch that touches these needs a person's review: label large-change (security, data, safety).
SENSITIVE_PATHS='(^|/)(auth|security|crypto|safety|migrations?)(/|[._-])|(^|/)\.env'
LICENSE_SEVERITY="HIGH,CRITICAL"              # trivy licence classes that block: forbidden = CRITICAL, restricted = HIGH
RESEARCH_MAX_AGE_DAYS=90                      # research findings are re-checked within this time (docs/research/README.md)
RESEARCH_EXEMPT_ADRS="0001"                   # decision numbers that need no research evidence
STOP_STAGES="fast test build"                 # what the agent's Stop hook runs (.claude/hooks/run-checks.sh)
# AI watermarks (ERE, case-insensitive) that fail commit messages, PR titles and PR bodies.
WATERMARK_PATTERN='^[[:space:]]*Co-Authored-By:.*(Claude|Anthropic|Copilot|ChatGPT|OpenAI|Gemini|Codex|Cursor|Aider|Devin)|^[[:space:]]*Claude-Session:|Generated (with|by) \[?(Claude|Copilot|ChatGPT|Codex|Cursor|Gemini)|🤖|claude\.ai/(code|chat)/[^[:space:]]*session'
SECURITY_SEVERITY="HIGH,CRITICAL"             # what blocks: deps gate, config, image
CANARY_DIR="tests/security-canary"
TODO_FILE="TODO.md"
DEP_DOCS="specs/*/plan.md docs/decisions/*.md"   # a new dependency must be named in one of these
SKIP_DIRS="node_modules,.dart_tool,build,dist,.venv,.tools,target,bin,obj"

# --- Pinned tools (bump by hand; checksums from the official release files) ----------------------
COPIER_VERSION="9.7.1"                                                                 # runs scripts/update-standard (uvx --from copier==...)
MARKDOWNLINT_VERSION="0.24.0"                                                          # markdownlint-cli2 on npm, released 2026-10-21
VALE_VERSION="3.26.0"                                                                  # released 2026-10-31
VALE_SHA256="22aa69a556558e4a9dfc63c17030777383d8d3c48dcdfad655fa98e839d666ed"        # vale_3.26.0_Linux_64-bit.tar.gz (vale_3.26.0_checksums.txt)
GITLEAKS_VERSION="8.30.1"
GITLEAKS_SHA256="551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb"   # gitleaks_8.30.1_linux_x64.tar.gz
TRIVY_VERSION="0.76.1"
TRIVY_SHA256="c7cbe3137fb8a48a17574bede3dd6beb16742d1e9772929940fc90082c39d9c0"      # trivy_0.76.1_Linux-64bit.tar.gz
OSV_VERSION="2.3.1"
OSV_SHA256="5bcd2d73fea96f58cb5aaf92d15907b1db53e009bc75d67b9ac965dba7c6ba54"        # osv-scanner_linux_amd64
OPENGREP_VERSION="2.0.0"
OPENGREP_SHA256="37e93f4da5fd04a18c5c1febbdd12f7e98dfccd4d0c9cf2593bcb25eeb462da0"   # opengrep_linux_x86; no sums file upstream: verify the .sig with cosign when bumping
LEFTHOOK_VERSION="2.2.3"
LEFTHOOK_SHA256="f25a53b1991c2727aa2819fdd7a4b9798fc0c210d1e1a92f035be8f346cec9fb"   # lefthook_2.2.3_Linux_x86_64.gz (lefthook_checksums.txt)
OPENGREP_RULES_COMMIT="f1d2b562b414783763fd02a6ed2736eaed622efa"                    # opengrep-rules, 2025-01-26

# Container fallbacks (same versions) for machines with Docker but without the binaries.
GITLEAKS_IMAGE="ghcr.io/gitleaks/gitleaks:v${GITLEAKS_VERSION}"
OSV_IMAGE="ghcr.io/google/osv-scanner:v${OSV_VERSION}"
TRIVY_IMAGE="aquasec/trivy:${TRIVY_VERSION}"
OPENGREP_IMAGE=""   # no official image: install the binary (scripts/install-tools)
