#!/usr/bin/env bash
#
# Installs the pinned tools into .tools/bin (git-ignored), checksum-verified, for Linux x86_64 (CI
# runners, dev containers, WSL): gitleaks, trivy, osv-scanner, opengrep, lefthook, vale.
#   scripts/install-tools             all of them
#   scripts/install-tools vale ...    only the named ones
# On macOS use Homebrew (gitleaks, trivy, osv-scanner, opengrep, lefthook, vale) or Docker; on
# Windows `winget install evilmartians.lefthook` and `winget install errata-ai.Vale`; scripts/check
# falls back to the pinned container images (not for Vale: without the binary the writing rule is
# skipped locally and fails in CI).
#
# Versions and checksums live in check.config. Bump them by hand (release notes, new checksum);
# Dependabot (.github/dependabot.yml) covers actions and packages, not these.
set -euo pipefail
cd "$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
source ./check.config

[[ "$(uname -s)-$(uname -m)" == "Linux-x86_64" ]] || { echo "Linux x86_64 only; use Homebrew or Docker here." >&2; exit 1; }
bin=.tools/bin
dl="$(mktemp -d)"
trap 'rm -rf "$dl"' EXIT
mkdir -p "$bin"
selected=("$@")
want() { [[ ${#selected[@]} -eq 0 ]] && return 0; local t; for t in "${selected[@]}"; do [[ "$t" == "$1" ]] && return 0; done; return 1; }

fetch() { # url sha256 output
    curl -fsSL "$1" -o "$3"
    echo "$2  $3" | sha256sum -c --quiet - || { echo "Checksum mismatch for $1" >&2; exit 1; }
}

if want gitleaks; then
    fetch "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" \
          "$GITLEAKS_SHA256" "$dl/gitleaks.tgz"
    tar -xzf "$dl/gitleaks.tgz" -C "$bin" gitleaks
fi

if want trivy; then
    fetch "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz" \
          "$TRIVY_SHA256" "$dl/trivy.tgz"
    tar -xzf "$dl/trivy.tgz" -C "$bin" trivy
fi

if want osv-scanner; then
    fetch "https://github.com/google/osv-scanner/releases/download/v${OSV_VERSION}/osv-scanner_linux_amd64" \
          "$OSV_SHA256" "$bin/osv-scanner"
fi

if want opengrep; then
    fetch "https://github.com/opengrep/opengrep/releases/download/v${OPENGREP_VERSION}/opengrep_linux_x86" \
          "$OPENGREP_SHA256" "$bin/opengrep"
fi

if want lefthook; then
    fetch "https://github.com/evilmartians/lefthook/releases/download/v${LEFTHOOK_VERSION}/lefthook_${LEFTHOOK_VERSION}_Linux_x86_64.gz" \
          "$LEFTHOOK_SHA256" "$dl/lefthook.gz"
    gunzip -c "$dl/lefthook.gz" > "$bin/lefthook"
fi

if want vale; then
    fetch "https://github.com/errata-ai/vale/releases/download/v${VALE_VERSION}/vale_${VALE_VERSION}_Linux_64-bit.tar.gz" \
          "$VALE_SHA256" "$dl/vale.tgz"
    tar -xzf "$dl/vale.tgz" -C "$bin" vale
fi

chmod +x "$bin"/*
for t in gitleaks trivy osv-scanner opengrep lefthook vale; do
    want "$t" && printf '%-12s %s\n' "$t" "$("$bin/$t" --version 2>&1 | head -n 1)"
done
echo "Installed in $bin (scripts/check adds it to PATH)."
