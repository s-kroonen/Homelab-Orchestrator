# ==============================================================================
# .env.local.example — developer override for running natively
# ------------------------------------------------------------------------------
# Copy to `.env.local` (git-ignored). Values here OVERRIDE `.env`.
#
# Why this file exists: `.env` is written for the container, where the app sees
# /data and /etc/orchestrator. Running `orchestrator` or `orchestrator-cli`
# directly on Windows or a dev box, those paths don't exist. Rather than editing
# your deployment config back and forth, put local paths here.
#
# `.env.local` is loaded second, so you only need to list what differs.
# ==============================================================================

# ---- Local paths (the usual reason for this file) --------------------------
DATABASE_URL=sqlite:///./data/orchestrator.db
STATE_DIR=./data
SERVICES_YAML_PATH=./config/services.yaml

# ---- Friendlier local logging ----------------------------------------------
LOG_FORMAT=console
LOG_LEVEL=INFO

# ---- Safety ----------------------------------------------------------------
# Keep dry-run on by default locally. Flip to false (or use
# `DRY_RUN=false orchestrator-cli check`) only when you intend to touch real
# Proxmox / PBS.
DRY_RUN=true

# Migrations are usually run by hand locally (`alembic upgrade head`).
RUN_MIGRATIONS_ON_START=false

# ---- Optional: point at real infrastructure for a live test ----------------
# Uncomment and fill in to test real connectivity from this machine. Your
# credentials still live in `.env`; only override what actually differs.
#
# PROXMOX_HOST=<the ALWAYS-ON node — see docs/architecture.md on single entry point>
# PBS_HOST=...
# PROXMOX_VERIFY_TLS=false   # if PVE still has its self-signed cert
# PBS_VERIFY_TLS=false
