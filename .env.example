# ==============================================================================
# homelab-orchestrator — example environment file
#
# You should not need to copy this. The setup wizard writes .env for you and
# checks every value against your cluster as it goes:
#
#     docker compose run --rm setup init
#
# By hand: copy to `.env` (git-ignored) and fill in. Never commit real hostnames,
# IPs, tokens or keys to a public repository.
#
# Generated from src/orchestrator/setup/envfile.py — edit the layout there, then
# run `python -m orchestrator.setup.envfile` to regenerate this file.
# ==============================================================================

# ---- Image (read by docker-compose.yml) --------------------------------------
# Pin a specific tag — never rely on :latest for the control plane.
# Tags: https://github.com/s-kroonen/homelab-orchestrator/pkgs/container/homelab-orchestrator
ORCHESTRATOR_IMAGE=ghcr.io/s-kroonen/homelab-orchestrator:1.0.0

# Host interface docker-compose.yml publishes :8080 on. Default 127.0.0.1
# (loopback only — front it with Traefik/Pangolin on THIS host). Set this to
# this host's LAN IP (or 0.0.0.0 for all interfaces) if Traefik/Pangolin runs
# on a DIFFERENT host and needs to reach this one directly.
ORCHESTRATOR_BIND_ADDR=127.0.0.1

# ---- Runtime -----------------------------------------------------------------
# development | production
ORCHESTRATOR_ENV=production

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# json | console
LOG_FORMAT=json

# IANA zone for displayed times and backup cron schedules (Europe/Amsterdam). Blank = the container's TZ, else UTC. Changeable on the System page.
TIMEZONE=

# Swaps ALL external adapters for logging no-ops: nothing is started,
# stopped or backed up. Leave on until `orchestrator-cli check` passes.
DRY_RUN=true

# null (log only) | auto (every channel configured below) | ntfy | email | webhook.
# DRY_RUN=true keeps it silent whatever this says. See docs/notifications.md.
NOTIFIER_ADAPTER=null

# Run backup policies on their schedule_cron. false = manual backups only.
SCHEDULER_ENABLED=true

# ---- Web / API ---------------------------------------------------------------
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# MUST match the hostname the dashboard is served on. Passkeys only work
# over HTTPS or on localhost.
WEBAUTHN_RP_ID=orchestrator.example.lan
WEBAUTHN_RP_NAME='Homelab Orchestrator'
WEBAUTHN_ORIGIN=https://orchestrator.example.lan

# Cookie signing secret. `init` generates one. By hand:
# python -c "import secrets;print(secrets.token_urlsafe(64))"
SESSION_SECRET=change-me-generate-a-long-random-string

# How long an admin-invite link (dashboard > Invite another admin) stays valid.
INVITE_TTL_HOURS=24

# Fresh installs only: lets the dashboard's /setup page write .env and
# config/services.yaml in this directory (mounted into the container).
# Set it in docker-compose.yml `environment:`, not here — see docs/deploying.md.
SETUP_PROJECT_DIR=

# ---- Persistence and registry ------------------------------------------------
# SQLite lives on a local Docker volume — NOT on NFS (locking).
DATABASE_URL=sqlite:////data/orchestrator.db
STATE_DIR=/data

# Optional periodic dump of SQLite to durable storage.
NFS_STATE_DUMP_PATH=
STATE_DUMP_INTERVAL_MINUTES=60

# Run alembic upgrade head on container start.
RUN_MIGRATIONS_ON_START=true

# The SAVED registry. Boot reconciles it into the DB; the dashboard edits
# the DB live and can Save back here or Reset from here.
SERVICES_YAML_PATH=/etc/orchestrator/services.yaml

# Where the connections live (Proxmox, PBS, Traefik Manager, Portainer, MQTT,
# notifier channels, SSH): edited from the dashboard, applied without a restart.
# Blank = connections.yaml in STATE_DIR. See docs/connections.md.
CONNECTIONS_PATH=

# This orchestrator's own site name (home, offsite...). Connections carry one too;
# it is how two orchestrators tell their own from each other's.
ORCHESTRATOR_SITE=

# ---- The orchestrator itself (backups, updates) ------------------------------
# Scheduled backups of the database + services.yaml into STATE_DIR/backups.
# Manual, pre-update, pre-migration and pre-restore backups always happen.
# See docs/system.md.
SELF_BACKUP_ENABLED=true
SELF_BACKUP_INTERVAL_HOURS=24

# Scheduled backups kept; older ones are pruned.
SELF_BACKUP_KEEP=14

# Where the update command runs, as a probe-style transport block in JSON,
# e.g. {"type": "host_agent", "host": "docker-host"}. Blank = show manual steps.
SELF_UPDATE_TRANSPORT=

# Run on the Docker host by the dashboard's Update button. Make it detach,
# because it replaces this container. docs/system.md has the full example.
SELF_UPDATE_COMMAND=
SELF_UPDATE_TIMEOUT_S=120

# GitHub repo that "is there a newer build?" looks at.
UPDATE_REPO=s-kroonen/homelab-orchestrator

# Blank = follow the tag of ORCHESTRATOR_IMAGE (dev or main).
UPDATE_BRANCH=

# Baked into the image by the build; leave blank.
ORCHESTRATOR_GIT_SHA=

# ---- Controllers (act on one service, not its whole guest) -------------------
CONTROLLER_TIMEOUT_S=20

# ---- Health scanning (periodic) ----------------------------------------------
# Periodically scan every enabled service in the background, sharing one
# cache across the whole cycle so a dependency (e.g. a gateway) is probed
# once and every dependent sees the SAME verdict for it. false = ServiceState
# only updates as a side effect of a wake or backup gate check.
HEALTH_SCAN_ENABLED=true

# How often the periodic scan cycle runs.
HEALTH_SCAN_INTERVAL_S=600

# How long HealthScanSample rows (the trend history) are kept before being
# pruned. Deliberately short — this is a monitoring trend view, not an audit
# trail (AuditEntry/PipelineRun already cover that for backups/wakes).
HEALTH_HISTORY_RETENTION_DAYS=7

# ---- Service IP discovery ----------------------------------------------------
# Periodically find each running guest's IP: QEMU guest agent / LXC first,
# then its NIC MACs in an ARP table and a DHCP leases file. A service's
# manual ip_address always wins. See docs/service_ips.md.
IP_DISCOVERY_ENABLED=true

# How often the discovery pass runs.
IP_DISCOVERY_INTERVAL_S=600

# Where the ARP / DHCP reads run, as a probe-style transport block in JSON,
# e.g. {"type": "host_agent", "host": "gateway"}. Blank = Proxmox only.
IP_DISCOVERY_TRANSPORT=

# Read the neighbour (ARP) table over it.
IP_DISCOVERY_ARP_ENABLED=true

# Comma-separated CIDRs to ping first so the ARP table is fresh (max /22).
IP_DISCOVERY_SWEEP_CIDRS=

# dnsmasq leases file on that host, e.g. /var/lib/misc/dnsmasq.leases.
IP_DISCOVERY_DHCP_LEASES_PATH=

# ---- Traefik drift detection -------------------------------------------------
# How often the in-app traffic collector polls {TRAEFIK_API_URL}/metrics
# (Prometheus text format — requires Traefik started with
# --metrics.prometheus=true). See docs/traffic_metrics.md.
TRAEFIK_METRICS_POLL_INTERVAL_S=60

# How long traffic samples are kept before being pruned.
TRAEFIK_METRICS_RETENTION_DAYS=14

# ---- Traefik Manager (write path) --------------------------------------------
# This orchestrator's own base URL AS REACHABLE FROM THE GATEWAY VM, e.g.
# http://10.0.0.5:8000 — not necessarily what a browser uses. Backend
# target for the maintenance-page fallback service. Empty = that feature
# is a no-op even if TRAEFIK_MANAGER_URL is set.
ORCHESTRATOR_PUBLIC_URL=http://10.0.0.5:8000

# ---- Access-log traffic (via Traefik Manager) --------------------------------
# Tail Traefik's access log through Traefik Manager (GET
# /api/traefik/logs) and roll it up per proxy host per minute for
# /traffic. Runs whenever PROXY_ADAPTER is a live Traefik Manager;
# TRAEFIK_API_URL is not needed. Traefik Manager's ACCESS_LOG_PATH must
# point at Traefik's access log (JSON format recommended). See
# docs/traffic_metrics.md.
ACCESS_LOG_ENABLED=true

# How often the access log is tailed.
ACCESS_LOG_POLL_INTERVAL_S=30

# Lines requested per poll (Traefik Manager caps this at 1000).
ACCESS_LOG_LINES=1000

# How long per-minute traffic rollups are kept before being pruned.
TRAFFIC_ROLLUP_RETENTION_DAYS=14

# ---- GeoIP traffic visibility (opt-in) ---------------------------------------
# Per-request client-IP/country visibility, sourced from Traefik's own
# access log tailed THROUGH TRAEFIK MANAGER (needs TRAEFIK_MANAGER_URL
# and an access log path configured on the gateway) — not a new direct
# SSH/filesystem integration. false = disabled entirely, no-op. See
# docs/geoip_traffic.md.
GEOIP_ENABLED=false

# Path to a MaxMind-format .mmdb file. Empty = auto-download and cache
# the free DB-IP city-lite database under {STATE_DIR}/geoip/, the same
# approach Traefik Manager's own GeoIP feature uses.
GEOIP_DB_PATH=

# DEPRECATED alias for ACCESS_LOG_POLL_INTERVAL_S, used only when that
# is not set. Leave empty.
GEOIP_TRAFFIC_POLL_INTERVAL_S=

# DEPRECATED alias for ACCESS_LOG_LINES, used only when that is not
# set. Leave empty.
GEOIP_ACCESS_LOG_LINES=

# How long GeoTrafficSample rows are kept before being pruned.
# Deliberately short — a monitoring trend view, not an audit trail.
GEOIP_TRAFFIC_RETENTION_DAYS=14

# ---- Reaching guests (probes) ------------------------------------------------
# Slug of the gateway service. New services get depends_on: [it], so a gateway
# outage reads as UNKNOWN downstream instead of every service failing at once.
GATEWAY_SERVICE=

# ---- Task timeouts -----------------------------------------------------------
# A large VM dump can legitimately take hours.
BACKUP_TASK_TIMEOUT_S=7200
VERIFY_TASK_TIMEOUT_S=1800

# Seconds before a scheduled backup that was blocked, or whose target did not turn healthy after boot, is tried again (up to the policy's max attempts).
BACKUP_RETRY_DELAY_S=300

# Seconds to wait after a backup before powering a node it woke back off.
BACKUP_POWER_OFF_GRACE_S=30

# Bounds the whole wake pipeline — a cold node can take minutes to POST, boot, and bring its guests up.
WAKE_TIMEOUT_S=600
WAKE_POLL_INTERVAL_S=5.0

# Just the Proxmox start task, not guest boot.
WAKE_GUEST_START_TIMEOUT_S=120

# After a wake ends, the next hit reuses it rather than retrying — without this, a fast failure gets re-triggered by every visitor request during an outage, not just page reloads.
WAKE_RETRY_COOLDOWN_S=30

# ---- Notifications -----------------------------------------------------------
# Contact the browsers' push services see (mailto: or https URL). Blank = the dashboard's https address.
PUSH_VAPID_SUBJECT=

# false = no alerts and no feed (state is not tracked).
NOTIFICATIONS_ENABLED=true

# A change must be seen on this many consecutive scans before it is announced.
NOTIFY_CONFIRM_SCANS=2

# This many changes inside the window = 'flapping'.
NOTIFY_FLAP_THRESHOLD=4
NOTIFY_FLAP_WINDOW_S=1800

# How long the feed on /notifications is kept.
NOTIFY_RETENTION_DAYS=30

# A deleted service stays in the archive (restorable from /archive) this many days.
ARCHIVE_RETENTION_DAYS=30

# How you reach this dashboard (https://orchestrator.example.com), used for
# the links in alerts. Falls back to ORCHESTRATOR_PUBLIC_URL.
EXTERNAL_URL=

# Global switch for automatic recovery (docs/recovery.md).
RECOVERY_ENABLED=true

# FAILED scans in a row before a recovery attempt.
RECOVERY_CONFIRM_SCANS=2

# How long a restore approval link stays valid.
APPROVAL_TTL_HOURS=24

# ---- Dumps (docs/dumps.md) ---------------------------------------------------
# Where a service's own database dumps are kept. Blank = STATE_DIR/dumps.
# Mount a share here to keep them off this host.
DUMP_DIR=

# ---- MCP server (docs/mcp.md) ------------------------------------------------
# Serve /mcp for AI assistants (Claude connectors) and its OAuth endpoints.
# Needs EXTERNAL_URL (or WEBAUTHN_ORIGIN) to be the address Claude can reach.
MCP_ENABLED=true

# Lifetime of an access token (it is refreshed).
MCP_ACCESS_TTL_S=3600

# A connection unused for this long must be re-authorised.
MCP_REFRESH_TTL_DAYS=90

# How long a request that needs a human stays open.
MCP_APPROVAL_TTL_MIN=60

# Hosts whose client metadata documents are fetched (comma-separated).
MCP_CIMD_HOSTS=claude.ai,claude.com
