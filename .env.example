# ==============================================================================
# homelab-orchestrator — example environment file
# ------------------------------------------------------------------------------
# Copy to `.env` and fill in with values for YOUR environment.
# The `.env` file is git-ignored — never commit real hostnames, IPs, tokens,
# or keys to a public repository.
# ==============================================================================

# ---- Image (used by docker-compose.yml on the Pi) --------------------------
# Pin a specific tag — never rely on `:latest` for the control plane.
# Full list of tags at:
#   https://github.com/s-kroonen/homelab-orchestrator/pkgs/container/homelab-orchestrator
ORCHESTRATOR_IMAGE=ghcr.io/s-kroonen/homelab-orchestrator:1.0.0

# ---- Runtime ---------------------------------------------------------------
ORCHESTRATOR_ENV=production            # development | production
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                         # json | console

# Dry-run swaps ALL external adapters for logging no-op impls. Safe for local dev.
DRY_RUN=true

# Per-adapter override: `mqtt|dry_run`, `api|dry_run`, `api|dry_run`.
# When DRY_RUN=true these are forced to dry_run regardless.
POWER_ADAPTER=mqtt
PROXMOX_ADAPTER=api
PBS_ADAPTER=api
NOTIFIER_ADAPTER=null

# ---- Web / API -------------------------------------------------------------
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# WebAuthn Relying Party ID — MUST match the hostname the dashboard is served on.
# Passkeys will only work over HTTPS or on `localhost`.
WEBAUTHN_RP_ID=orchestrator.example.lan
WEBAUTHN_RP_NAME=Homelab Orchestrator
WEBAUTHN_ORIGIN=https://orchestrator.example.lan

# Cookie signing secret — generate with `python -c "import secrets;print(secrets.token_urlsafe(64))"`.
SESSION_SECRET=change-me-generate-a-long-random-string

# ---- Persistence -----------------------------------------------------------
# SQLite lives on a local Docker volume — NOT on NFS (locking).
DATABASE_URL=sqlite:////data/orchestrator.db
STATE_DIR=/data

# Optional periodic dump of SQLite to durable storage.
NFS_STATE_DUMP_PATH=                    # e.g. /mnt/state-dumps
STATE_DUMP_INTERVAL_MINUTES=60

# Run alembic upgrade head on container start.
RUN_MIGRATIONS_ON_START=true

# ---- Service registry ------------------------------------------------------
# Path to the YAML file that is the SAVED source of truth for the service registry.
# On boot the DB is reconciled from this file. The dashboard writes changes to
# the DB (live) and can Save back to this path or Reset from it.
SERVICES_YAML_PATH=/etc/orchestrator/services.yaml

# ---- Proxmox ---------------------------------------------------------------
# IMPORTANT: point this at your ALWAYS-ON node. Proxmox proxies API calls
# between cluster nodes, so one endpoint can address all of them — but if this
# host is a burst node that powers off, the orchestrator loses API access
# exactly when it needs it to wake things. See docs/proxmox_connectivity.md.
PROXMOX_HOST=proxmox.example.lan
PROXMOX_PORT=8006
PROXMOX_VERIFY_TLS=true
# Scoped API token — routine-backups role only. Restore uses a separate token.
PROXMOX_TOKEN_ID=orchestrator@pve!backups
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Higher-privilege token used only inside the greenlight/restore flow.
PROXMOX_RESTORE_TOKEN_ID=orchestrator@pve!restore
PROXMOX_RESTORE_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# The PVE *storage ID* pointing at PBS — what `vzdump storage=` expects.
# Find it with: pvesm status    (or Datacenter -> Storage in the PVE UI)
# NOT necessarily the same string as PBS_DATASTORE below.
PVE_BACKUP_STORAGE=example-pbs-storage

# ---- Proxmox Backup Server -------------------------------------------------
PBS_HOST=pbs.example.lan
PBS_PORT=8007
PBS_VERIFY_TLS=true
# The PBS *datastore name* — what the PBS API addresses.
PBS_DATASTORE=example-datastore
# Node name PBS runs tasks under; "localhost" on a standalone install.
PBS_NODE_NAME=localhost
PBS_TOKEN_ID=orchestrator@pbs!datastore
PBS_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---- Task timeouts ---------------------------------------------------------
BACKUP_TASK_TIMEOUT_S=7200
VERIFY_TASK_TIMEOUT_S=1800

# ---- Power manager (MQTT) --------------------------------------------------
MQTT_HOST=mqtt.example.lan
MQTT_PORT=1883
MQTT_USERNAME=orchestrator
MQTT_PASSWORD=change-me
MQTT_TLS=false
# Topic prefix the existing power manager publishes/subscribes on.
MQTT_POWER_TOPIC_PREFIX=power/nodes

# ---- Notifier (phase 9) ----------------------------------------------------
# mailcow SMTP (used only when mailcow itself is healthy — see spec §9)
MAIL_SMTP_HOST=mail.example.lan
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=orchestrator@example.lan
MAIL_SMTP_PASSWORD=change-me
MAIL_FROM=orchestrator@example.lan

# Offsite ntfy for instant fallback alerts
NTFY_URL=https://ntfy.example.com/homelab-alerts
NTFY_TOKEN=
