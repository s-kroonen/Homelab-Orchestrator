# Tools and agent state
.tools/
.claude/settings.local.json
docs/handover/*
!docs/handover/.gitkeep

# Dependencies and build output (every stack)
node_modules/
.venv/
target/
dist/
build/
.dart_tool/
obj/

# Test and coverage output
coverage/
coverage.xml
lcov.info
.coverage
.vitest-cache/
__pycache__/

# Secrets: never commit
.env
.env.*
!.env.example
*.pem
*.key
*service-account*.json

# OS / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Python tooling created by uvx is outside the repo; nothing else needed at day 0

# project: below this line (the standard never edits what follows)
# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Local runtime / state — never commit
data/
*.db
*.db-journal
*.sqlite
*.sqlite-journal
state-dumps/

# Local config with real values — always keep OUT of the public repo
.env
.env.*
!.env.example
!.env.local.example
config/services.yaml
# Connections hold credentials (written by the dashboard / `orchestrator-cli connections`).
config/connections.yaml
config/connections-backups/
config/services.*.yaml
!config/services.example.yaml
config/*.local.*
# Copies taken before `orchestrator-cli init` / `config edit` replace a file.
# They hold the same secrets and addresses as the originals.
*.bak-*
config/*.tmp

# Secrets (SOPS-encrypted files are OK to commit; decrypted are not)
*.decrypted.*
secrets/*.yaml
!secrets/*.enc.yaml
# The master key (docs/secrets.md), whatever it is called. Never commit it.
secrets/orchestrator_master_key*
*.key

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Claude Code agent worktree scratch space — never project content
.claude/worktrees/
